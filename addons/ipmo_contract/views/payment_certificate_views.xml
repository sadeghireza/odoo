<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ipmo_payment_certificate_tree" model="ir.ui.view">
        <field name="name">ipmo.payment.certificate.tree</field>
        <field name="model">ipmo.payment.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="pc_no" />
                <field name="agreement_id" />
                <field name="pc_date" />
                <field name="gross_amount" />
                <field name="net_amount" />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="view_ipmo_payment_certificate_form" model="ir.ui.view">
        <field name="name">ipmo.payment.certificate.form</field>
        <field name="model">ipmo.payment.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="status != 'draft'" />
                    <button name="action_approve" type="object" string="Approve" invisible="status != 'submitted'" />
                    <field name="status" widget="statusbar" statusbar_visible="draft,submitted,approved" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="agreement_id" />
                            <field name="pc_no" />
                            <field name="pc_date" />
                        </group>
                        <group>
                            <field name="period_from" />
                            <field name="period_to" />
                            <field name="deduction_amount" />
                        </group>
                    </group>
                    <group>
                        <field name="gross_amount" readonly="1" />
                        <field name="net_amount" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="status != 'draft'">
                                <list editable="bottom">
                                    <field name="agreement_line_id" />
                                    <field name="executed_quantity" />
                                    <field name="executed_percent" />
                                    <field name="actual_cost" />
                                    <field name="payable_amount" readonly="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ipmo_payment_certificate" model="ir.actions.act_window">
        <field name="name">Payment Certificates</field>
        <field name="res_model">ipmo.payment.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
