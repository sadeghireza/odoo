<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_ipmo_contract" model="ir.ui.view">
        <field name="name">res.users.form.ipmo.contract</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="PMIS Access">
                    <field name="allowed_project_ids" widget="many2many_tags" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
