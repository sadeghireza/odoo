<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ipmo_vendor_tree" model="ir.ui.view">
        <field name="name">ipmo.vendor.tree</field>
        <field name="model">ipmo.vendor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="vendor_type" />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="view_ipmo_vendor_form" model="ir.ui.view">
        <field name="name">ipmo.vendor.form</field>
        <field name="model">ipmo.vendor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="vendor_type" />
                        <field name="status" />
                    </group>
                    <group>
                        <field name="national_id" />
                        <field name="economic_code" />
                        <field name="bank_account" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ipmo_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">ipmo.vendor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
