<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_contract_creator" model="res.groups">
        <field name="name">Contract Creator</field>
        <field name="category_id" ref="base.module_category_project" />
    </record>

    <record id="group_contract_reviewer" model="res.groups">
        <field name="name">Contract Reviewer</field>
        <field name="category_id" ref="base.module_category_project" />
    </record>

    <record id="group_contract_approver" model="res.groups">
        <field name="name">Contract Approver</field>
        <field name="category_id" ref="base.module_category_project" />
        <field name="implied_ids" eval="[(4, ref('ipmo_contract.group_contract_creator')), (4, ref('ipmo_contract.group_contract_reviewer'))]" />
    </record>

    <record id="rule_ipmo_agreement_project" model="ir.rule">
        <field name="name">Agreement project access</field>
        <field name="model_id" ref="model_ipmo_agreement" />
        <field name="domain_force">[('project_id', 'in', user.allowed_project_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('ipmo_contract.group_contract_creator')), (4, ref('ipmo_contract.group_contract_reviewer')), (4, ref('ipmo_contract.group_contract_approver'))]" />
    </record>

    <record id="rule_ipmo_agreement_line_project" model="ir.rule">
        <field name="name">Agreement line project access</field>
        <field name="model_id" ref="model_ipmo_agreement_line" />
